##############################################################################
# .gitignore
# WHY THIS FILE EXISTS:
#   Prevents sensitive, auto-generated, and unnecessary files from being
#   committed to GitHub. Everything listed here stays local only.
##############################################################################

# Python cache files
# WHY: Automatically generated by Python — never manually created.
#      Contain compiled bytecode that is machine-specific and should
#      never be version controlled.
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
# WHY: Dependencies are installed fresh from requirements.txt.
#      Virtual environment folders are large, machine-specific,
#      and have no place in version control.
venv/
.venv/
env/
ENV/

# Environment files
# WHY: May contain API keys, passwords, and secrets.
#      The most critical entry in this entire file.
.env
.env.local
.env.production

# Docker files
# WHY: Auto-generated by Docker during builds — not source code.
#      No value in committing these to GitHub.
.docker/

# Operating system files
# WHY: Auto-generated by Windows and Mac — irrelevant to the project.
.DS_Store
Thumbs.db
desktop.ini

# VS Code settings
# WHY: Editor preferences are personal — should not be forced
#      on other developers cloning your repository.
.vscode/

# Log files
# WHY: Generated at runtime — not source code.
*.log
logs/

# Local testing artifacts
# WHY: Any local test output should never reach version control.
*.coverage
.pytest_cache/