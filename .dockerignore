##############################################################################
# .dockerignore
# WHY THIS FILE EXISTS:
#   Prevents unnecessary, sensitive, and machine-specific files from being
#   copied into your Docker image during the build process.
#   A clean image is a smaller, faster, and more secure image.
##############################################################################

# Python cache files
# WHY: Machine-specific compiled bytecode — causes unpredictable
#      behavior inside the container and bloats image size.
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
# WHY: Dependencies are installed fresh inside the container via
#      pip install. Copying a local venv in would conflict with
#      the container's own installation.
venv/
.venv/
env/
ENV/

# Git files
# WHY: Version control history has no place inside a container.
#      Copying .git/ in bloats the image significantly.
.git/
.gitignore

# GitHub Actions
# WHY: Pipeline configuration files are not needed to run the app.
.github/

# Environment files
# WHY: The most critical entry — .env files may contain secrets,
#      API keys, and passwords. If copied into a Docker image and
#      pushed to Docker Hub they become publicly accessible to anyone
#      who pulls the image.
.env
.env.local
.env.production

# Documentation
# WHY: README and markdown files are not needed to run the app.
#      Excluding them keeps the image focused and minimal.
*.md
README*

# Docker files
# WHY: No need to copy Dockerfile into the image it is building.
Dockerfile
docker-compose*

# Operating system files
# WHY: Auto-generated by Windows and Mac — never needed inside
#      a Linux-based container.
.DS_Store
Thumbs.db
desktop.ini

# VS Code settings
# WHY: Editor configuration is personal and irrelevant inside
#      a container.
.vscode/

# Log files
# WHY: Runtime generated files should never be baked into an image.
*.log
logs/

# Test files
# WHY: Test code and results are not needed in a production image.
*.coverage
.pytest_cache/
tests/